{
  "name": "nesped",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unidad && npm run test:e2e",
    "test:unidad": "node scripts/revisar-shaders.mjs && node --import ./tests/alias.mjs --test \"tests/unidad/*.test.mjs\"",
    "test:unidad:watch": "node --import ./tests/alias.mjs --test --watch \"tests/unidad/*.test.mjs\"",
    "export-project": "bash scripts/export-project.sh",
    "verify:env": "node scripts/validate-env.mjs",
    "verify:prod": "node scripts/validate-env.mjs && next build --webpack",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "revisar": "node scripts/revisar-sitio.mjs",
    "revisar:portal": "node scripts/revisar-portal.mjs",
    "revisar:admin": "node scripts/revisar-admin.mjs",
    "revisar:seguridad": "node scripts/revisar-seguridad.mjs",
    "revisar:secretos": "node scripts/revisar-secretos.mjs",
    "verificar:auditoria": "node --import ./tests/alias.mjs scripts/verificar-auditoria.mjs",
    "probar:voz": "node scripts/probar-voz.mjs",
    "probar:conversacion": "node scripts/probar-conversacion.mjs",
    "volcar:migraciones": "node scripts/volcar-migraciones.mjs",
    "revisar:shaders": "node scripts/revisar-shaders.mjs",
    "conectar:numero": "node scripts/conectar-numero.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.50.0",
    "@sentry/node": "^10.50.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@supabase/supabase-js": "^2.99.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "next": "^16.2.3",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.4",
    "stripe": "^20.4.1",
    "ws": "^8.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4"
  }
}
